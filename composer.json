{
  "name": "maatify/logger",
  "description": "maatify.dev logger, known by our team",
  "type": "library",
  "keywords": [
    "PHP",
    "Logger",
    "Handler"
  ],
  "homepage": "https://github.com/Maatify/",
  "license": "proprietary",
  "authors": [
    {
      "name": "Mohamed Abdulalim",
      "email": "mohamed@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Backend Developer"
    },
    {
      "name": "Ahmed Fawzy",
      "email": "a.fawzy@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Frontend Developer"
    },
    {
      "name": "Mohaned Saeed Sami",
      "email": "mohaned.saeed@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Frontend Developer"
    },
    {
      "name": "Ahmed Abdullah",
      "email": "a.abdullah@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "Android Developer"
    },
    {
      "name": "Elmokhtar Ahmed",
      "email": "mokhtar@maatify.dev",
      "homepage": "https://www.maatify.com/",
      "role": "IOS Developer"
    }
  ],
  "require": {
    "php": ">=8.4.27 <8.5.0 || >=8.5.12 <8.6.0",
    "ext-json": "*",
    "monolog/monolog": "^3.9",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "composer/semver": "^3.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Logger\\": "src/",
      "Maatify\\Store\\File\\": "src/store/file/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Logger\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "validate:strict": "composer validate --strict",
    "check:platform": "composer check-platform-reqs",
    "check:php-floors": "php scripts/check-php-floors.php",
    "lint:php": "php scripts/lint-php.php",
    "lint:whitespace": "php scripts/check-whitespace.php",
    "lint:workflows": "scripts/lint-workflows.sh",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "audit:deps": "composer audit --no-interaction --abandoned=fail",
    "test": "phpunit tests",
    "ci": [
      "@validate:strict",
      "@check:platform",
      "@check:php-floors",
      "@lint:php",
      "@lint:whitespace",
      "@analyse",
      "@test",
      "@audit:deps"
    ]
  }
}
